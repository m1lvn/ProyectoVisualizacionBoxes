# Variables de entorno para desarrollo local
# Copia este archivo como .env y ajusta los valores

# IMPORTANTE: Las credenciales AWS NO van aquí
# En AWS Academy, las credenciales van en ~/.aws/credentials
# Ve a: AWS Academy > Learner Lab > AWS Details > Show > Copy to ~/.aws/credentials

# AWS Region (la única configuración AWS que necesitas aquí)
AWS_DEFAULT_REGION=us-east-1

# DynamoDB Configuration
DYNAMODB_TABLE=HospitalData
DYNAMODB_ENDPOINT=https://dynamodb.us-east-1.amazonaws.com

# Para desarrollo local con DynamoDB local (opcional)
# DYNAMODB_ENDPOINT=http://localhost:8000

# MySQL Connection (para migración)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=bdHospital

# API Configuration
API_BASE_URL=https://your-api-gateway-url.amazonaws.com/dev

# Debug
DEBUG=true
LOG_LEVEL=info