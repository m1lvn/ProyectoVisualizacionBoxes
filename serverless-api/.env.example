# Variables de entorno para desarrollo local
# Copia este archivo como .env y ajusta los valores

# AWS Configuration (AWS Academy - credenciales temporales)
# IMPORTANTE: En AWS Academy, las credenciales expiran cada pocas horas
# Obtienes estas credenciales desde: AWS Academy > Learner Lab > AWS Details > Show

AWS_ACCESS_KEY_ID=ASIA_TU_ACCESS_KEY_AQUI
AWS_SECRET_ACCESS_KEY=tu_secret_access_key_aqui
AWS_SESSION_TOKEN=tu_session_token_muy_largo_aqui
AWS_DEFAULT_REGION=us-east-1

# DynamoDB Configuration
DYNAMODB_TABLE=HospitalData
DYNAMODB_ENDPOINT=https://dynamodb.us-east-1.amazonaws.com

# Para desarrollo local con DynamoDB local (opcional)
# DYNAMODB_ENDPOINT=http://localhost:8000

# MySQL Connection (para migración)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=bdHospital

# API Configuration
API_BASE_URL=https://your-api-gateway-url.amazonaws.com/dev

# Debug
DEBUG=true
LOG_LEVEL=info