# Variables de entorno para desarrollo local serverless
# ============================================
# INSTRUCCIONES:
# 1. Copia este archivo como .env: cp .env.example .env
# 2. Ajusta los valores según tu entorno AWS
# 3. NUNCA subas el archivo .env al repositorio (está en .gitignore)
# ============================================

# IMPORTANTE: Las credenciales AWS NO van aquí
# En AWS Academy, las credenciales van en ~/.aws/credentials
# Pasos:
#   1. Ve a: AWS Academy > Learner Lab > AWS Details
#   2. Click en "Show" para ver las credenciales
#   3. Copialas a ~/.aws/credentials (en Windows: C:\Users\TuUsuario\.aws\credentials)

# ============================================
# AWS CONFIGURATION
# ============================================

# Región de AWS donde se desplegará la infraestructura
AWS_DEFAULT_REGION=us-east-1

# ID de tu cuenta AWS (obtenerlo de AWS Console o AWS Academy)
# Ejemplo: 123456789012
AWS_ACCOUNT_ID=YOUR_AWS_ACCOUNT_ID

# Nombre del rol IAM que usarán las Lambda functions
# En AWS Academy suele ser "LabRole"
AWS_IAM_ROLE=LabRole

# ============================================
# LAMBDA CONFIGURATION
# ============================================

# Runtime de Node.js para las funciones Lambda
# Versiones soportadas: nodejs18.x, nodejs20.x
LAMBDA_RUNTIME=nodejs18.x

# Timeout máximo para la función de setup de usuarios (en segundos)
# 300 segundos = 5 minutos (necesario para crear todos los usuarios de prueba)
LAMBDA_TIMEOUT=300

# ============================================
# SERVERLESS OFFLINE (Desarrollo Local)
# ============================================

# Puerto donde correrá el servidor local
SERVERLESS_OFFLINE_PORT=3001

# Host para desarrollo local
# 0.0.0.0 permite acceso desde cualquier IP (útil para Docker/WSL)
# localhost solo permite acceso local
SERVERLESS_OFFLINE_HOST=0.0.0.0

# ============================================
# DYNAMODB CONFIGURATION
# ============================================

# Nombre de la tabla DynamoDB principal
DYNAMODB_TABLE=HospitalData

# Endpoint de DynamoDB
# Producción: https://dynamodb.us-east-1.amazonaws.com
# Local (DynamoDB Local): http://localhost:8000
DYNAMODB_ENDPOINT=https://dynamodb.us-east-1.amazonaws.com

# ============================================
# COGNITO CONFIGURATION
# ============================================

# Nombre base del User Pool de Cognito
# El sistema agregará el stage automáticamente: hospital-users-dev
COGNITO_USER_POOL_NAME=hospital-users

# Nombre base del Client de Cognito
# El sistema agregará el stage automáticamente: hospital-web-client-dev
COGNITO_CLIENT_NAME=hospital-web-client

# ============================================
# TOKEN VALIDITY (Importante para Chaos Engineering)
# ============================================

# Validez del Access Token en MINUTOS
# Valor recomendado: 60 minutos para pruebas de caos
# Producción típica: 15-60 minutos
ACCESS_TOKEN_VALIDITY=60

# Validez del ID Token en MINUTOS
# Debe coincidir con Access Token
ID_TOKEN_VALIDITY=60

# Validez del Refresh Token en DÍAS
# Permite renovar tokens sin volver a autenticarse
# Valor típico: 7-30 días
REFRESH_TOKEN_VALIDITY=30

# ============================================
# SNS TOPICS CONFIGURATION
# ============================================

# Prefijo para los nombres de los topics SNS
# Topics finales: dev-hospital-user-events, dev-hospital-agenda-events, etc.
SNS_TOPICS_PREFIX=hospital

# ============================================
# MYSQL CONFIGURATION (Solo para migración)
# ============================================
# Estas variables son opcionales y solo se usan si necesitas
# conectarte a una base de datos MySQL existente para migración

# Host del servidor MySQL
MYSQL_HOST=localhost

# Usuario de MySQL
MYSQL_USER=root

# Contraseña de MySQL
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD

# Nombre de la base de datos
MYSQL_DATABASE=bdHospital

# ============================================
# DEBUG & LOGGING
# ============================================

# Habilitar modo debug (muestra logs detallados)
DEBUG=true

# Nivel de logging: error, warn, info, debug
LOG_LEVEL=info