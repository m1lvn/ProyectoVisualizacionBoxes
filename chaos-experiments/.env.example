# ════════════════════════════════════════════════════════════════
# Variables de Entorno para Chaos Engineering
# ════════════════════════════════════════════════════════════════
# 
# ✅ Las credenciales AWS se toman automáticamente de ~/.aws/credentials
# ✅ Solo necesitas configurar JWT_TOKEN para los experimentos
#

# ════════════════════════════════════════════════════════════════
# 🔵 API CONFIGURATION (Instancia EC2)
# ════════════════════════════════════════════════════════════════

# API corriendo en EC2 Ubuntu (ProyectoVisualizacionBoxes)
# Obtener IP con: aws ec2 describe-instances --filters "Name=tag:Name,Values=ProyectoVisualizacionBoxes"
API_ENDPOINT=http://3.95.177.254:8000/api

# ════════════════════════════════════════════════════════════════
# 🔐 AUTENTICACIÓN (3 OPCIONES)
# ════════════════════════════════════════════════════════════════

# OPCIÓN A: Credenciales Cognito (RECOMENDADO - Totalmente automático)
# Estas son las MISMAS credenciales que usas en tu aplicación Django
COGNITO_USERNAME=tu_email@example.com
COGNITO_PASSWORD=tu_password_aqui

# 🔍 CÓMO OBTENER ESTA URL:
# 1. Busca en: ProyectoHospital/ProyectoHospital/settings.py
# 2. Línea 21: SERVERLESS_AUTH_URL = 'https://...'
# 3. O desde terminal: aws apigateway get-rest-apis
SERVERLESS_AUTH_URL=https://44wvhl6j05.execute-api.us-east-1.amazonaws.com

# OPCIÓN B: JWT Token manual (si no quieres usar credenciales)
# 📝 OBTENER DE: Hacer login y copiar desde Developer Tools > Network > Headers
JWT_TOKEN=

# NOTA: Si configuras COGNITO_USERNAME y COGNITO_PASSWORD, 
#       el JWT_TOKEN se obtendrá automáticamente.
#       Si solo configuras JWT_TOKEN, se usará ese valor directamente.

# ════════════════════════════════════════════════════════════════
# 🔵 AWS CONFIGURATION
# ════════════════════════════════════════════════════════════════

# ✅ Las credenciales se leen automáticamente de:
#    $env:USERPROFILE\.aws\credentials (Windows)
#    ~/.aws/credentials (Linux/Mac)
#
# ✅ Ya configuradas: aws sts get-caller-identity funciona
# ✅ Account ID detectado: 891377117593

AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Account ID (auto-detectado, pero puedes dejarlo para referencia)
AWS_ACCOUNT_ID=891377117593

# ════════════════════════════════════════════════════════════════
# 🔵 GREMLIN CONFIGURATION (Solo si usarás Gremlin Free)
# ════════════════════════════════════════════════════════════════

# 📝 OBTENER DE: https://app.gremlin.com/signup
# Después de registrarte: Settings > Team Settings > API Keys

GREMLIN_TEAM_ID=
GREMLIN_API_KEY=
GREMLIN_API_SECRET=

# ════════════════════════════════════════════════════════════════
# 🔵 DYNAMODB (Ya configurado en serverless-api/.env.example)
# ════════════════════════════════════════════════════════════════

DYNAMODB_TABLE=HospitalData

# ════════════════════════════════════════════════════════════════
# 🔵 SNS TOPICS (Para experimento #3)
# ════════════════════════════════════════════════════════════════

# Nombres de los topics SNS del proyecto
SNS_TOPIC_USER_EVENTS=dev-hospital-user-events
SNS_TOPIC_AGENDA_EVENTS=dev-hospital-agenda-events
SNS_TOPIC_NOTIFICATIONS=dev-hospital-notifications

# ════════════════════════════════════════════════════════════════
# 📋 RESUMEN DE QUÉ NECESITAS CONFIGURAR
# ════════════════════════════════════════════════════════════════

# ✅ Ya configurado (no tocar):
#   - API_ENDPOINT (de .env.development)
#   - AWS_REGION (de serverless-api/.env.example)
#   - DYNAMODB_TABLE (de serverless-api/.env.example)
#   - SNS topics (nombres estándar del proyecto)

# ⚠️ Debes obtener:
#   - JWT_TOKEN: Login en la API y copiar token
#   - AWS_ACCOUNT_ID: Ejecutar aws sts get-caller-identity
#   - GREMLIN_*: Solo si usarás Gremlin (experimentos #6 y #7)

# ✅ Ya debe estar en ~/.aws/credentials:
#   - aws_access_key_id
#   - aws_secret_access_key
#   - aws_session_token (si usas AWS Academy)

# ════════════════════════════════════════════════════════════════
# 🚀 COMANDOS RÁPIDOS PARA CONFIGURAR
# ════════════════════════════════════════════════════════════════

# 1. Obtener JWT Token:
#    curl -X POST https://rc3ltywoub.execute-api.us-east-1.amazonaws.com/dev/api/auth/login \
#      -H "Content-Type: application/json" \
#      -d '{"username":"tu_usuario","password":"tu_password"}'
#    
#    Copiar el token y pegarlo en JWT_TOKEN arriba

# 2. Obtener AWS Account ID:
#    aws sts get-caller-identity --query Account --output text
#    
#    Copiar el ID y pegarlo en AWS_ACCOUNT_ID arriba

# 3. Cargar variables en terminal:
#    Windows PowerShell:
#      Get-Content .env | ForEach-Object { if ($_ -match '^([^#][^=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2], 'Process') } }
#    
#    Linux/Mac:
#      source .env
#      # o con export:
#      export $(cat .env | grep -v '^#' | xargs)

# ════════════════════════════════════════════════════════════════
# 📝 NOTAS IMPORTANTES
# ════════════════════════════════════════════════════════════════

# - Este archivo NO debe subirse a Git (ya está en .gitignore)
# - Las credenciales AWS deben estar en ~/.aws/credentials
# - El JWT_TOKEN expira después de unas horas, necesitarás renovarlo
# - GREMLIN_* solo es necesario para experimentos #6 y #7
# - Para AWS Academy, recuerda que las credenciales expiran después de 4 horas
