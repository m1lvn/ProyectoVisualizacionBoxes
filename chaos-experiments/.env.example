# ════════════════════════════════════════════════════════════════
# Configuración para Chaos Engineering
# ════════════════════════════════════════════════════════════════
#
# Este archivo es generado automáticamente por setup.sh
# NO edites este archivo manualmente
#
# Para actualizar la configuración ejecuta:
#   ./setup.sh
#

# JWT Token de Cognito User Pool (válido por 60 minutos)
JWT_TOKEN=

# API Gateway HTTP API endpoint
API_ENDPOINT=

# CloudFormation stack name
STACK_NAME=hospital-boxes-api-dev

# Región AWS
AWS_REGION=us-east-1


# ════════════════════════════════════════════════════════════════
# 📝 NOTAS IMPORTANTES
# ════════════════════════════════════════════════════════════════

# - Este archivo NO debe subirse a Git (ya está en .gitignore)
# - Las credenciales AWS deben estar en ~/.aws/credentials
# - El JWT_TOKEN expira después de unas horas, necesitarás renovarlo
# - GREMLIN_* solo es necesario para experimentos #6 y #7
# - Para AWS Academy, recuerda que las credenciales expiran después de 4 horas
