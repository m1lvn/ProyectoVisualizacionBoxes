# ============================================
# TERRAFORM VARIABLES - EXAMPLE FILE
# ============================================
# INSTRUCCIONES:
# 1. Copia este archivo como terraform.tfvars:
#    cp terraform.tfvars.example terraform.tfvars
# 2. Ajusta los valores según tu entorno AWS
# 3. NUNCA subas terraform.tfvars al repositorio (está en .gitignore)
# ============================================

# ============================================
# AWS CONFIGURATION
# ============================================

# Región de AWS donde desplegar
region = "us-east-1"

# ID de cuenta AWS - NO NECESARIO (se obtiene automáticamente)
# Terraform usa data.aws_caller_identity.current.account_id
# Asegúrate de tener credenciales válidas en ~/.aws/credentials

# Nombre del proyecto (prefijo para recursos)
project_name = "hospital-boxes"

# Entorno (dev, staging, prod)
environment = "dev"

# ============================================
# EC2 CONFIGURATION
# ============================================

# Tipo de instancia (t2.micro es free tier)
django_instance_type = "t2.micro"

# URL de tu repositorio GitHub
github_repo_url = "https://github.com/m1lvn/ProyectoVisualizacionBoxes.git"

# Puerto Django
django_port = 8000

# ============================================
# LAMBDA CONFIGURATION
# ============================================

lambda_runtime = "nodejs18.x"
lambda_timeout = 30
lambda_memory  = 256
lambda_setup_users_timeout = 300

# ============================================
# COGNITO CONFIGURATION
# ============================================

cognito_user_pool_name = "hospital-users"
cognito_client_name    = "hospital-web-client"

# Token validity (importante para chaos engineering)
access_token_validity   = 60  # minutos
id_token_validity       = 60  # minutos
refresh_token_validity  = 30  # días

password_minimum_length = 8

# ============================================
# DYNAMODB CONFIGURATION
# ============================================

dynamodb_table_name    = "HospitalData"
dynamodb_billing_mode  = "PAY_PER_REQUEST"
enable_dynamodb_pitr   = true
enable_dynamodb_streams = true

# ============================================
# SNS CONFIGURATION
# ============================================

sns_topics_prefix = "hospital"

# ============================================
# API GATEWAY CONFIGURATION
# ============================================

api_gateway_name = "hospital-boxes-api"
api_throttle_burst_limit = 5000
api_throttle_rate_limit  = 2000

# ============================================
# FEATURE FLAGS
# ============================================

enable_vpc_flow_logs        = false
enable_api_gateway_logging  = true
enable_lambda_insights      = false
create_test_users           = true

# ============================================
# SECURITY CONFIGURATION
# ============================================

# ⚠️ PRODUCCIÓN: Restringir a IPs específicas
allowed_ssh_cidr  = ["0.0.0.0/0"]
allowed_http_cidr = ["0.0.0.0/0"]

# ============================================
# TAGS
# ============================================

common_tags = {
  Project     = "Hospital Boxes Visualization"
  ManagedBy   = "Terraform"
  Environment = "dev"
  Team        = "DevOps"
  Course      = "Arquitectura de Sistemas"
  University  = "UDD"
}
