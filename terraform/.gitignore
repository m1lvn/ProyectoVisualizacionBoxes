# ============================================
# TERRAFORM .gitignore
# ============================================

# Local .terraform directories
**/.terraform/*

# .tfstate files (contienen secretos y estado sensible)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (contienen valores específicos del usuario)
*.tfvars
*.tfvars.json

# Ignore override files (se usan para sobrescribir recursos temporalmente)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negation (!)
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# ============================================
# ARCHIVOS ESPECÍFICOS DEL PROYECTO
# ============================================

# ZIP de Lambda generado automáticamente
lambda.zip
*.zip

# Claves SSH generadas por Terraform
*.pem
*.key
my-ec2-key.pem

# Archivos de backup
*.backup
*.bak

# Logs
*.log

# Archives
*.tar
*.gz
*.tgz

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*$py.class
